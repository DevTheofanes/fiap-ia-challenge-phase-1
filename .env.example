# LLM provider settings (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM provider settings (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: force a mock client for offline runs (true/false)
LLM_USE_MOCK=false

# HuggingFace token (required for gated models like meta-llama/Llama-3.2-1B)
HF_TOKEN=your_huggingface_token_here
